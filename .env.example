# =============================================================
# NIPPIA SKD MASTER — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi `.env` lalu ganti seluruh placeholder.
# JANGAN PERNAH meng-commit file `.env` asli ke Git!
# =============================================================

# PostgreSQL
POSTGRES_USER=nippia
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_DB_PASSWORD>
POSTGRES_DB=skd_master
POSTGRES_PORT=5433
DATABASE_URL="postgresql://nippia:<REPLACE_WITH_STRONG_DB_PASSWORD>@localhost:5433/skd_master?schema=public"

# Redis (Wajib untuk sinkronisasi Socket.IO multi-instance / Live Akbar skala besar)
REDIS_PASSWORD=<REPLACE_WITH_STRONG_REDIS_PASSWORD>
REDIS_URL="redis://:<REPLACE_WITH_STRONG_REDIS_PASSWORD>@localhost:6379"

# Backend Server & Keamanan
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=true
# Pada produksi isi domain HTTPS asli tanpa trailing slash (pisahkan koma jika lebih dari satu)
CORS_ORIGIN="https://app.example.com"
APP_URL="https://app.example.com"

# JWT Secrets (WAJIB berbeda antara access & refresh, minimal 32 karakter acak cryptographically strong)
# Contoh generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="<REPLACE_WITH_RANDOM_64_CHAR_HEX_ACCESS_SECRET>"
JWT_REFRESH_SECRET="<REPLACE_WITH_RANDOM_64_CHAR_HEX_REFRESH_SECRET>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Sign-In OAuth 2.0 (Opsional — isi dari Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Midtrans Payment Gateway
# Sandbox: MIDTRANS_IS_PRODUCTION=false | Production: MIDTRANS_IS_PRODUCTION=true
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# Frontend Build Variables (Hanya konfigurasi publik — JANGAN taruh secret di VITE_*)
VITE_API_URL="/api/v1"
VITE_APP_URL="https://app.example.com"
VITE_APP_ENV="production"
VITE_GOOGLE_CLIENT_ID=""
VITE_ENABLE_DEMO_LOGIN="false"
