# Database
POSTGRES_USER=nippia
POSTGRES_PASSWORD=nippia_secret_2026
POSTGRES_DB=skd_master
POSTGRES_PORT=5433
DATABASE_URL="postgresql://nippia:nippia_secret_2026@localhost:5433/skd_master?schema=public"
# Redis (Opsional — untuk distributed Socket.IO Pub/Sub adapter & cache event live)
REDIS_URL=""

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

# Google Sign-In OAuth 2.0 (Opsional — isi dengan kredensial GCP Web Application Anda)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# JWT Secrets (Ganti pada produksi dengan string acak minimal 32 karakter)
JWT_ACCESS_SECRET="nippia_skd_master_dev_access_secret_key_2026"
JWT_REFRESH_SECRET="nippia_skd_master_dev_refresh_secret_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Service (Opsional - jika kosong menggunakan Grounded Local Tutor Engine)
# Pilihan AI_PROVIDER: "gemini" | "openai" | "local-grounded"
AI_PROVIDER="local-grounded"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gemini-2.5-flash"

# Midtrans Payment Gateway (Sandbox / Production)
# Daftar di https://dashboard.midtrans.com lalu salin Server Key & Client Key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# Frontend
VITE_API_URL="http://localhost:4000/api/v1"
